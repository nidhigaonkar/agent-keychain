# Browser Use Cloud API key — get one at https://cloud.browser-use.com/settings?tab=api-keys
BROWSER_USE_API_KEY=

# Optional: browser profile with synced login cookies (see profile sync guide)
# BROWSER_USE_PROFILE_ID=

# Optional: auto-populated when Link is connected at cloud.browser-use.com → Integrations
# BROWSER_USE_STRIPE_LINK_CONNECTION_ID=
